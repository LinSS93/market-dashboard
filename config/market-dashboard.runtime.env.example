# Optional local Radar configuration. All producers are disabled by default.
# The RADAR_* names below are internal compatibility identifiers; legacy RADAR_V2_* keys are still accepted.
# Copy to market-dashboard.runtime.env. Do not put API keys in this file.

RADAR_SCANNER_ENABLED=0
RADAR_DOSSIER_ENABLED=0
RADAR_TREND_ENABLED=0
RADAR_FUNDAMENTAL_ENABLED=0
RADAR_THESIS_ENABLED=0
